---
import BayjfLink from "@bay/landing-ui/components/BayjfLink.astro";
import StarOnGithub from "@bay/landing-ui/components/StarOnGithub.astro";
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations, getAltLangPath, localizePath } from "../i18n";
import { SOCIAL } from "../consts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altPath = getAltLangPath(Astro.url, lang);
const home = localizePath("/", lang);
---

<header class="top">
  <div class="shell top__inner">
    <a class="top__brand" href={home} aria-label="growth-agent">
      <Logo size={30} />
      <span class="top__name">GROWTH&#8209;AGENT</span>
    </a>
    <div class="top__right">
      <span class="top__status">
        <span class="dot"></span>
        {t("hud.status")}
      </span>
      <nav class="top__ext">
        <BayjfLink size={18} />
        <span class="top__star">
          <StarOnGithub href={SOCIAL.github} size={15} />
        </span>
        <a class="lang-switch" href={altPath} hreflang={lang === "zh" ? "en" : "zh-CN"}>
          {t("nav.langSwitch")}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 14px 0;
    background: color-mix(in srgb, var(--steel-950) 82%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--hair);
  }
  .top__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .top__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .top__name {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.24em;
    white-space: nowrap;
  }
  .top__right {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .top__status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px var(--amber);
    flex: none;
  }
  .top__ext {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
  }
  /* :global, because these anchors come from @bay/landing-ui and so carry that
     component's scope attribute rather than this one's */
  .top__ext :global(a) {
    transition: color 160ms ease-out;
  }
  .top__ext :global(a:hover) {
    color: var(--grow);
  }
  .lang-switch {
    white-space: nowrap;
  }
  .lang-switch:hover {
    color: var(--grow);
  }

  @media (max-width: 760px) {
    .top__status {
      display: none;
    }
  }
  @media (max-width: 640px) {
    /* the star pill crowds the brand + lang switch on phones; the footer
       carries the same link, so nothing is lost */
    .top__star {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .top__name {
      font-size: 12px;
      letter-spacing: 0.18em;
    }
  }
</style>
