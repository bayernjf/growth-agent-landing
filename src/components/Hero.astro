---
import { getLangFromUrl, useTranslations, localizePath } from "../i18n";
import { SOCIAL } from "../consts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const lines = ["term.l1", "term.l2", "term.l3", "term.l4", "term.l5", "term.l6", "term.l7"] as const;
---

<section class="hero" id="top">
  <div class="shell hero__inner">
    <div class="hero__copy">
      <p class="kicker">{t("hero.kicker")}</p>
      <h1 class="hero__title">{t("hero.title")}</h1>
      <p class="hero__sub">{t("hero.sub")}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={localizePath("/#cta", lang)}>{t("hero.cta")}</a>
        <a class="btn btn--ghost" href={`${SOCIAL.github}#readme`} target="_blank" rel="noopener noreferrer">
          {t("hero.cta2")}
        </a>
      </div>
      <div class="hero__meta">
        <span><b>1 + 1</b> {t("hero.meta.cap")}</span>
        <span><b>D2</b> {t("hero.meta.gate")}</span>
        <span><b>BYOK</b> {t("hero.meta.byok")}</span>
        <span><b>docker</b> {t("hero.meta.host")}</span>
      </div>
    </div>

    <figure class="panel hero__term" aria-label={t("term.caption")}>
      <div class="hero__term-bar">
        <i></i><i></i><i></i>
        <span>batch — tick</span>
      </div>
      <pre><code>{t("term.cmd")}{"\n\n"}{lines.map((l) => t(l)).join("\n")}</code></pre>
      <figcaption>{t("term.caption")}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 88px 0 64px;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }
  /* grid items default to min-width:auto, which lets the <pre> blow out the
     track on narrow screens — allow both columns to shrink instead */
  .hero__copy,
  .hero__term {
    min-width: 0;
  }
  .hero__title {
    margin-top: 18px;
    font-size: clamp(32px, 4.6vw, 52px);
    letter-spacing: -0.02em;
  }
  .hero__sub {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-dim);
    max-width: 600px;
  }
  .hero__actions {
    margin-top: 34px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero__meta {
    margin-top: 42px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  .hero__meta b {
    color: var(--grow);
    font-weight: 800;
  }
  .hero__meta span {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
  }

  /* terminal card — one tick of the batch scheduler */
  .hero__term {
    margin: 0;
    overflow: hidden;
  }
  .hero__term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--steel-700);
  }
  .hero__term-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--steel-600);
  }
  .hero__term-bar i:first-child {
    background: var(--grow-dim);
  }
  .hero__term-bar span {
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
  }
  .hero__term pre {
    margin: 0;
    padding: 18px 20px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.9;
    color: var(--ink-dim);
  }
  .hero__term figcaption {
    padding: 10px 20px 14px;
    border-top: 1px solid var(--steel-700);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: 64px 0 48px;
    }
    .hero__term pre {
      font-size: 11px;
    }
  }
</style>
